{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.codex/hooks/harness_hook.py\" session-start",
            "commandWindows": "python .codex/hooks/harness_hook.py session-start",
            "timeout": 10,
            "statusMessage": "harness: 세션 컨텍스트 주입"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.codex/hooks/harness_hook.py\" prompt",
            "commandWindows": "python .codex/hooks/harness_hook.py prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.codex/hooks/harness_hook.py\" pretool",
            "commandWindows": "python .codex/hooks/harness_hook.py pretool",
            "timeout": 10,
            "statusMessage": "harness: 가드레일 검사"
          }
        ]
      }
    ]
  }
}
